# --- Database & Cache ---
DB_URL=postgresql://cepu_user:cepu_password@localhost:5432/cepu
REDIS_URL=redis://localhost:6379/0

# --- Autentikasi Internal (Gateway WA -> Backend API) ---
INTERNAL_TOKEN=

# --- Machine Learning (Hugging Face IndoBERT) ---
MODEL_VERSION=indobert-v1
HF_MODEL_ID=Kiuyha/indobert-job-fraud-detection
NER_MODEL_ID=fahmisyaifudin/indobert_ner_p1
BERT_MAX_LENGTH=512
NER_MAX_LENGTH=512

# --- WhatsApp Gateway ---
WA_SESSION_PATH=./gateway-wa/session

# --- Rate Limiting & OCR ---
RATE_LIMIT_DETECT_PER_MINUTE=10
OCR_LANG=ind+eng

# --- Third-party Verification Services ---
# (Cookie sesi & token opsional dapat diisi melalui secret env)
COMPANYHOUSE_BASE_URL=https://companyhouse.id
COMPANYHOUSE_SESSION_COOKIE=
COMPANYHOUSE_USER_AGENT=
COMPANYHOUSE_TIMEOUT_SECONDS=5.0

ADUANNOMOR_BASE_URL=https://aduannomor.id
ADUANNOMOR_TIMEOUT_SECONDS=5.0

KREDIBEL_BASE_URL=https://www.kredibel.com
KREDIBEL_SESSION_COOKIE=
KREDIBEL_USER_AGENT=
KREDIBEL_TIMEOUT_SECONDS=6.0

# --- Email Domain Blocklist ---
DISPOSABLE_DOMAINS_SYNC_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/master/disposable_email_blocklist.conf
DISPOSABLE_EMAIL_DOMAINS=yopmail.com,mailinator.com,tempmail.com,guerrillamail.com,10minutemail.com,trashmail.com,sharklasers.com,dispostable.com
FREE_EMAIL_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,icloud.com,aol.com,zoho.com

# --- Frontend Client Configuration ---
VITE_API_URL=http://127.0.0.1:5687
