# Salin jadi .env lalu isi nilai aslinya:  cp .env.example .env
# Hanya kunci yang WAJIB / berbeda dari default yang tercantum di sini.
# Knob lanjutan (rate limit, timeout, dsb.) ada default-nya di api/core/config.py.

# --- Database & Cache ---
DB_URL=postgresql://postgres@localhost:5432/cepu
REDIS_URL=redis://localhost:6379/0

# --- Autentikasi Internal (Gateway WA -> Backend API) ---
# WAJIB diisi dengan nilai yang sama di backend & gateway-wa.
INTERNAL_TOKEN=isi-token-acak-di-sini

# --- Portal Admin ---
ADMIN_PASSWORD=ganti-password-ini

# --- Machine Learning ---
BERT_MAX_LENGTH=512

# --- Third-party Verification Services (secret cookie sesi, opsional) ---
# Panen via: .venv/bin/python scripts/refresh_browser_sessions.py --site all --headed --profile-dir ./sessions/chrome --write-env
# (sudah termasuk cf_clearance; otomatis tertulis ke .env + backup .env.bak). Restart backend sesudahnya.
COMPANYHOUSE_SESSION_COOKIE=
KREDIBEL_SESSION_COOKIE=

# --- Anti-ban (opsional; kosong = langsung tanpa proxy) ---
# Egress via IP tepercaya bila IP server di-flag, mis. "http://user:pass@ip:8080"
# atau "socks5h://127.0.0.1:1080" (hasil `ssh -D 1080 user@mesin-rumah`).
# COMPANYHOUSE_PROXY=
# KREDIBEL_PROXY=
# JOBSTREET_PROXY=
# Circuit breaker: berhenti memukul host yang memblokir selama cooldown.
# SCRAPE_CIRCUIT_THRESHOLD=3
# SCRAPE_CIRCUIT_COOLDOWN_SECONDS=900

# --- JobStreet (tanpa cookie; ID opsional, kosong = otomatis acak) ---
# Umur maksimal data tersimpan (jam) — lewat dari ini scrape ulang 1 halaman.
# JOBSTREET_CACHE_TTL_HOURS=24
JOBSTREET_SESSION_ID=

# --- Frontend / Gateway Client ---
VITE_API_URL=http://127.0.0.1:5687
